  "rulesGoalTitle": "Maqsad",
  "@rulesGoalTitle": { "description": "Правила: цель игры" },

  "rulesGoalBody": "Barcha 15 toshni aylana bo'ylab o'z uyingizga — 1-6 punktlarga — olib boring va raqibdan oldin chiqarib oling. Urish yo'q, bar yo'q: toshlar hech qachon urilmaydi.",
  "@rulesGoalBody": { "description": "Правила: цель" },

  "rulesStartTitle": "Boshlanish va yo'nalish",
  "@rulesStartTitle": { "description": "Правила: старт" },

  "rulesStartBody": "Boshida barcha 15 tosh boshda turadi. Ikkala tomon halqa bo'ylab bir yo'nalishda yuradi, lekin boshlari yarim aylana masofada — shuning uchun toshlar yuzma-yuz uchrashmaydi.",
  "@rulesStartBody": { "description": "Правила: старт" },

  "rulesMoveTitle": "Yurish",
  "@rulesMoveTitle": { "description": "Правила: ход" },

  "rulesMoveBody": "Ikki zar tashlanadi: ikki yurish, xohlasangiz bitta tosh bilan ketma-ket. Juft tushsa — to'rt yurish. Raqibning hech bo'lmaganda bitta toshi turgan punktga borib bo'lmaydi; o'z toshlaringiz bir punktda cheksiz tura oladi.",
  "@rulesMoveBody": { "description": "Правила: ход" },

  "rulesHeadTitle": "Bosh qoidasi",
  "@rulesHeadTitle": { "description": "Правила: голова" },

  "rulesHeadBody": "Bitta tashlashda boshdan faqat bitta tosh olinadi. Istisno — partiyadagi eng birinchi tashlash: 6-6, 4-4 yoki 3-3 tushsa, ikkita tosh olish mumkin.",
  "@rulesHeadBody": { "description": "Правила: голова" },

  "rulesFullTitle": "To'liq yurish",
  "@rulesFullTitle": { "description": "Правила: обязательность полного хода" },

  "rulesFullBody": "Yurish imkon qadar uzun bo'lishi shart: ikkala sonni ham ishlatish kerak, juftda esa to'rttadan qanchasi chiqsa. Faqat bitta son o'ynalsa — kattasi o'ynaladi. Umuman yurish bo'lmasa, navbat raqibga o'tadi.",
  "@rulesFullBody": { "description": "Правила: полный ход" },

  "rulesBlockTitle": "Blok qoidasi",
  "@rulesBlockTitle": { "description": "Правила: блок из шести" },

  "rulesBlockBody": "Ketma-ket oltita punktni egallash mumkin emas, agar to'siq oldida raqibning birorta ham toshi qolmasa. Uning kamida bitta toshi oldinda bo'lsa — blok mumkin.",
  "@rulesBlockBody": { "description": "Правила: блок" },

  "rulesBearOffTitle": "Chiqarish",
  "@rulesBearOffTitle": { "description": "Правила: выброс" },

  "rulesBearOffBody": "Barcha 15 tosh uyga yig'ilgach, chiqarish boshlanadi: k punktdagi tosh aynan k soni bilan chiqadi. Tushgan son eng uzoq band punktdan katta bo'lsa — o'sha punktdagi tosh chiqadi. Chiqarish o'rniga uy ichida yurish ham mumkin.",
  "@rulesBearOffBody": { "description": "Правила: выброс" },

  "rulesResultTitle": "Natija",
  "@rulesResultTitle": { "description": "Правила: результат" },

  "rulesResultBody": "Barcha 15 toshni birinchi bo'lib chiqargan yutadi. Oddiy g'alaba — oyin, 1 ochko; raqib bitta ham chiqara olmasa — mars, 2 ochko. Match 3, 5 yoki 7 ochkogacha o'ynaladi.",
  "@rulesResultBody": { "description": "Правила: результат" },

